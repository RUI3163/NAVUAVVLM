{
  // Same scene file for every Project AirSim map: the running Unreal binary (AirSim_Neighborhood) selects the map.
  // origin.xyz = spawn in world NED (m). The stock value below is a placeholder: set it to the house spawn point.
  // M0 prints the pose the sim actually reports so you can confirm or correct it.
  "id": "SceneBasicDrone",
  "actors": [
    {
      "type": "robot",
      "name": "Drone1",
      "origin": { "xyz": "-1.0 8.0 -4.0", "rpy-deg": "0 0 0" },
      "robot-config": "robot_quadrotor_vlnav.jsonc"
    }
  ],
  "clock": { "type": "steppable", "step-ns": 3000000, "real-time-update-rate": 3000000, "pause-on-start": false },
  "home-geo-point": { "latitude": 33.04735, "longitude": -97.292663, "altitude": 222.0 },
  "segmentation": { "initialize-ids": true, "ignore-existing": false, "use-owner-name": true },
  "scene-type": "UnrealNative"
}
